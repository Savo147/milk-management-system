# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API Keys

# Public — sent to the browser. RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
